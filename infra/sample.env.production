# Production Environment Configuration for Neon
# Copy this to .env.production and fill in your actual values

# Neon PostgreSQL connection string
# Get this from your Neon dashboard or from PR comments (for preview branches)
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?sslmode=require

# Google OAuth credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Secret for signing JWTs (generate a secure random string)
JWT_SECRET="your_production_jwt_secret_here"

# Cloudflare R2 configuration (optional, for image uploads)
R2_ACCOUNT_ID="your_r2_account_id"
R2_BUCKET="your_r2_bucket_name"
R2_ENDPOINT="https://your_account_id.r2.cloudflarestorage.com"
R2_TOKEN="your_r2_token"

# Neon Project Configuration (for CI/CD)
NEON_PROJECT_ID="your_neon_project_id"
NEON_API_KEY="your_neon_api_key"
