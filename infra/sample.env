# PostgreSQL connection string
# For local development with Docker Compose:
DATABASE_URL=postgresql+asyncpg://skateuser:skatepassword@postgres:5432/skatespot
# For production with Neon:
# DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname?sslmode=require

# Google OAuth credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# Secret for signing JWTs
JWT_SECRET="a_very_secret_key_that_should_be_long_and_random" 